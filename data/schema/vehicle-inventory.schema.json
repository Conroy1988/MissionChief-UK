{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conroy1988.github.io/MissionChief-UK/schema/vehicle-inventory.schema.json",
  "title": "MissionChief UK Vehicle Source Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "collection",
    "updated_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "collection": {
      "const": "uk-vehicle-source-ledger"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "scope_note": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "game_vehicle_type_id",
          "name",
          "service",
          "resource_class",
          "canonical_id",
          "label_status",
          "type_id_status",
          "sources"
        ],
        "properties": {
          "game_vehicle_type_id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "resource_class": {
            "enum": [
              "vehicle",
              "aircraft",
              "vessel",
              "trailer",
              "container",
              "equipment"
            ]
          },
          "canonical_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label_status": {
            "enum": [
              "verified",
              "candidate",
              "review-required"
            ]
          },
          "type_id_status": {
            "enum": [
              "verified",
              "community-candidate",
              "review-required"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
