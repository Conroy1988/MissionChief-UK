{
  "components": {
    "schemas": {
      "CollectionEnvelope": {
        "properties": {
          "collection": {
            "type": "string"
          },
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "data_version": {
            "type": "string"
          },
          "records": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "released_at": {
            "format": "date",
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "data_version",
          "count",
          "records"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only versioned JSON exports generated from evidence-led MissionChief UK records.",
    "title": "MissionChief UK Static Data API",
    "version": "1.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/faq.json": {
      "get": {
        "operationId": "getFaq",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Generated FAQ entries"
          }
        },
        "summary": "Retrieve generated FAQ"
      }
    },
    "/infrastructure.json": {
      "get": {
        "operationId": "getInfrastructure",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Infrastructure collection envelope"
          }
        },
        "summary": "Retrieve the infrastructure collection"
      }
    },
    "/manifest.json": {
      "get": {
        "operationId": "getManifest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Version and collection manifest"
          }
        },
        "summary": "Retrieve API manifest"
      }
    },
    "/missions.json": {
      "get": {
        "operationId": "getMissions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Missions collection envelope"
          }
        },
        "summary": "Retrieve the missions collection"
      }
    },
    "/search-index.json": {
      "get": {
        "operationId": "getSearchIndex",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Search index envelope"
          }
        },
        "summary": "Retrieve lightweight search index"
      }
    },
    "/training.json": {
      "get": {
        "operationId": "getTraining",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Training collection envelope"
          }
        },
        "summary": "Retrieve the training collection"
      }
    },
    "/vehicles.json": {
      "get": {
        "operationId": "getVehicles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Vehicles collection envelope"
          }
        },
        "summary": "Retrieve the vehicles collection"
      }
    }
  },
  "servers": [
    {
      "description": "Production GitHub Pages endpoint",
      "url": "https://conroy1988.github.io/MissionChief-UK/assets/data/v1"
    }
  ]
}
